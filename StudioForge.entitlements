<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened runtime: allow audio input (required for recording when notarized). -->
    <key>com.apple.security.device.audio-input</key><true/>
    <!-- Allow loading third-party plug-ins / bundled ffmpeg signed by other teams. -->
    <key>com.apple.security.cs.disable-library-validation</key><true/>
    <!-- The app is NOT sandboxed (it needs ~/Music/Fitzrovia Records DAW and arbitrary audio files).
         The keys below only take effect if com.apple.security.app-sandbox is enabled later;
         they document what a sandboxed build would need. -->
    <key>com.apple.security.files.user-selected.read-write</key><true/>
    <key>com.apple.security.assets.music.read-write</key><true/>
    <key>com.apple.security.network.client</key><true/>
    <key>com.apple.security.device.bluetooth</key><true/>
</dict>
</plist>
